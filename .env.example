# Convex deployment URL (database endpoint -- used by Nuxt runtime and Convex CLI)
# Dev: http://localhost:3210
# Cloud: https://your-project-123.convex.cloud
CONVEX_URL=

# Convex site URL (auth HTTP routes -- used by Better Auth client)
# Dev: same as CONVEX_URL (http://localhost:3210)
# Cloud: https://your-project-123.convex.site
CONVEX_SITE_URL=

# Self-hosted Convex settings (for `npx convex dev` CLI)
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# App branding (optional)
# APP_NAME=OpenClaw
# APP_LOGO_URL=https://example.com/logo.png
